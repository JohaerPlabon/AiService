@using AiService.AccountManager.Repository.DTO
@model RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<div class="container-fluid p-0">
    <div class="row min-vh-100 g-0">
        <!-- Left Side -->
        <div class="col-md-6 d-flex flex-column justify-content-center align-items-center bg-dark text-white p-5">
            <h2 class="fw-bold">Create your free account</h2>
            <p class="mt-3">Explore AiService’s core features for individuals and organizations.</p>
            <img src="~/Assets/Images/6534538.jpg" alt="Illustration" class="img-fluid mt-4" style="max-height: 300px;" />
        </div>

        <!-- Right Side -->
        <div class="col-md-6 d-flex flex-column justify-content-center p-5">
            <div class="text-center mb-2">
                <img src="~/Assets/Images/ai-technology.png" alt="Logo" style="width:30px; height:30px;" />
            </div>

            <h3 class="mb-4 text-center" style="font-size:18px">Sign up for AiService</h3>

            <a href="/Auth/LoginWithGoogle" class="btn btn-light border d-flex align-items-center justify-content-center mb-3">
                <img src="~/Assets/Images/google.png" alt="Google" style="width:20px; height:20px;" class="me-2" />
                Continue with Google
            </a>

            <div class="d-flex align-items-center my-3">
                <hr class="flex-grow-1" />
                <span class="mx-2 text-muted">or</span>
                <hr class="flex-grow-1" />
            </div>

            <form method="post" novalidate>
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label">Email</label>
                        <a href="/Auth/SignIn" class="small">I have an Account!</a>
                    </div>
                    <input asp-for="Email" class="form-control" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input asp-for="UserName" class="form-control" placeholder="Username" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button class="btn btn-dark w-100 py-2 fw-bold" type="submit">Create account →</button>
            </form>

            <p class="mt-3 small text-muted">
                By creating an account, you agree to the <a href="/Home/Terms">Terms of Service</a>.
                For more information, see the <a href="/Home/Privacy">Privacy Policy</a>.
            </p>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
