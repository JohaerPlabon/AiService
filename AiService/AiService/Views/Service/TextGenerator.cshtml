

<div class="d-flex justify-content-center align-items-center vh-100" style="background: #f5f5f5;">
    <!-- Chat Container -->
    <div class="card shadow-lg rounded-4" style="width: 400px; max-width: 95%; height: 600px; display: flex; flex-direction: column; overflow: hidden;">

        <!-- Header -->
        <div class="bg-primary text-white text-center py-3">
            <h5 class="mb-0">AI Text Generator</h5>
            <small>Type, speak, or send images</small>
        </div>

        <!-- Messages -->
        <div id="chatMessages" class="flex-grow-1 p-3" style="overflow-y: auto; background: #f9f9f9;">
            <!-- Example AI message -->
            <div class="d-flex mb-2">
                <div class="bg-primary text-white p-2 rounded-3 shadow-sm" style="max-width: 75%;">
                    Hello! I am your AI assistant. How can I help you today?
                </div>
            </div>
        </div>

        <!-- Input area -->
        <div class="p-3" style="background: #ffffff; border-top: 1px solid #e0e0e0;">
            <form id="chatForm" class="d-flex align-items-center gap-2">
                <!-- Voice -->
                <button type="button" class="btn btn-light rounded-circle p-2 shadow-sm" title="Voice Input">
                    <i class="bi bi-mic-fill fs-5"></i>
                </button>

                <!-- Image -->
                <button type="button" class="btn btn-light rounded-circle p-2 shadow-sm" title="Send Image">
                    <i class="bi bi-image fs-5"></i>
                </button>

                <!-- Text Input -->
                <input type="text" id="userInput" class="form-control rounded-pill" placeholder="Type your message..." />

                <!-- Send Button -->
                <button type="submit" class="btn btn-primary rounded-circle p-2 shadow-sm">
                    <i class="bi bi-send-fill fs-5"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<!-- Inline Script to handle sending messages -->
<script>
    const chatForm = document.getElementById('chatForm');
    const chatMessages = document.getElementById('chatMessages');
    const userInput = document.getElementById('userInput');

    chatForm.addEventListener('submit', function (e) {
        e.preventDefault();
        const text = userInput.value.trim();
        if (!text) return;

        // Create user message
        const userMsg = document.createElement('div');
        userMsg.classList.add('d-flex', 'mb-2', 'justify-content-end');
        userMsg.innerHTML = `<div class="bg-light p-2 rounded-3 shadow-sm" style="max-width:75%;">${text}</div>`;
        chatMessages.appendChild(userMsg);

        // Scroll to bottom
        chatMessages.scrollTop = chatMessages.scrollHeight;

        // Clear input
        userInput.value = '';

        // Simulate AI response after delay
        setTimeout(() => {
            const aiMsg = document.createElement('div');
            aiMsg.classList.add('d-flex', 'mb-2');
            aiMsg.innerHTML = `<div class="bg-primary text-white p-2 rounded-3 shadow-sm" style="max-width:75%;">This is an AI response to: "${text}"</div>`;
            chatMessages.appendChild(aiMsg);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }, 800);
    });
</script>
