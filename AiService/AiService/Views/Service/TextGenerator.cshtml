@{
    ViewBag.Title = "ChatGPT-like Chat";
}

<head>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --sidebar-w: 72px;
            --max-width: 900px;
            --bg: #f6f7f8;
            --muted: #6b6f76;
            --accent: #10a37f;
        }

        html, body {
            margin: 0;
            height: 100%;
            overflow: hidden; /* Disable page scroll */
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            background: var(--bg);
            color: #111;
        }

        .app {
            display: flex;
            height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-w);
            background: #111214;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 14px 8px;
            gap: 10px;
        }

        .center {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end; /* Keep input at bottom */
            padding: 28px 16px;
            height: 100%;
        }

        .conversation-wrap {
            display: flex;
            flex-direction: column;
            width: 100%;
            max-width: var(--max-width);
            flex-grow: 1;
            overflow-y: auto; /* Only chat scrolls */
            margin-bottom: 12px;
        }

        /* Topbar */
        .topbar {
            height: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 300;
            margin-bottom: 8px;
        }

            .topbar .title {
                font-weight: 600;
                font-size: 15px;
            }

            .topbar .subtitle {
                font-size: 13px;
                color: var(--muted);
            }

        /* Chat bubbles */
        .msg-col {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
            max-width: 760px;
        }

        .bubble {
            padding: 16px;
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(15,23,42,0.06);
            background: #fff;
            position: relative;
            font-size: 15px;
            line-height: 1.45;
            border: 1px solid rgba(15,23,42,0.04);
            word-break: break-word;
        }

            .bubble.ai {
                align-self: flex-start;
                background: #fff;
                color: #111;
            }

            .bubble.user {
                align-self: flex-end;
                background: linear-gradient(90deg,#0b86ff,#0066d6);
                color: white;
            }

            .bubble .meta {
                font-size: 12px;
                color: var(--muted);
                margin-bottom: 8px;
            }

        .copy-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 14px;
            color: var(--muted);
            padding: 6px;
            border-radius: 6px;
        }

        .bubble img {
            max-width: 320px;
            border-radius: 8px;
            margin-top: 8px;
        }

        .bubble audio {
            margin-top: 8px;
            width: 100%;
        }

        /* Input area */
        .input-area {
            height: 72px;
            width: 100%;
            display: flex;
            justify-content: center;
            padding: 12px 16px;
            flex-shrink: 0;
        }

        .input-pill {
            width: 100%;
            max-width: var(--max-width);
            display: flex;
            align-items: center;
            background: #fff;
            border-radius: 28px;
            padding: 8px 12px;
            box-shadow: 0 6px 20px rgba(15,23,42,0.06);
            gap: 10px;
            border: 1px solid rgba(15,23,42,0.06);
            position: relative;
        }

        .text-input {
            flex: 1;
            border: none;
            outline: none;
            font-size: 16px;
            padding: 12px 14px;
            border-radius: 20px;
            resize: none;
            overflow-y: auto;
            max-height: 100px;
            line-height: 1.4;
            word-wrap: break-word;
        }

        .send-icon-btn, .icon-btn, .send-circle, .plus-btn {
            cursor: pointer;
        }

        .spinner {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid rgba(0,0,0,0.08);
            border-top-color: #888;
            animation: spin 1s linear infinite;
            display: inline-block;
            margin-right: 8px;
        }
    </style>
</head>

<body>
    <div class="app shadow">

        <!-- Center column -->
        <div class="center">
            <div class="conversation-wrap" id="messages">
                <div class="msg-col">
                    <div class="bubble ai" data-role="ai">
                        <div class="meta">Assistant</div>
                        Hello! I’m ready to help. Click <strong>+</strong> to attach image/audio, or use the mic to speak.
                        <button class="copy-btn" title="Copy response" onclick="copyBubble(this)">📋</button>
                    </div>
                </div>
            </div>

            <!-- Input area -->
            <div class="input-area">
                <div class="input-pill">
                    <button class="icon-btn" id="plusBtn"><i class="fa fa-plus"></i></button>

                    <div class="plus-menu" id="plusMenu">
                        <button id="addImageBtn"><i class="fa fa-image"></i> Add Image</button>
                        <button id="addAudioBtn"><i class="fa fa-music"></i> Add Audio</button>
                    </div>

                    <input id="fileInput" type="file" style="display:none" />

                    <textarea id="textInput" class="text-input" placeholder="Ask anything..." rows="1"></textarea>

                    <div class="right-tools">
                        <button class="send-icon-btn" id="voiceBtn"><i class="fa fa-microphone"></i></button>
                        <button class="send-icon-btn" id="sendBtn"><i class="fa fa-paper-plane"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JS (Formatted version of your code) -->
    <script>
        // ... Insert the properly formatted JS code from the previous answer here ...
        // This keeps all your chat functionalities intact.
    </script>
</body>


    <script>
        const plusBtn = document.getElementById('plusBtn');
        const plusMenu = document.getElementById('plusMenu');
        const fileInput = document.getElementById('fileInput');
        const addImageBtn = document.getElementById('addImageBtn');
        const addAudioBtn = document.getElementById('addAudioBtn');
        const messages = document.getElementById('messages');
        const sendBtn = document.getElementById('sendBtn');
        const textInput = document.getElementById('textInput');
        const voiceBtn = document.getElementById('voiceBtn');

        let pendingFile = null;

        plusBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            plusMenu.style.display = plusMenu.style.display === 'flex' ? 'none' : 'flex';
        });
        document.addEventListener('click', () => plusMenu.style.display = 'none');

        addImageBtn.addEventListener('click', () => { fileInput.accept = 'image/*'; fileInput.click(); });
        addAudioBtn.addEventListener('click', () => { fileInput.accept = 'audio/*'; fileInput.click(); });

        fileInput.addEventListener('change', (e) => {
            if (!e.target.files || !e.target.files[0]) return;
            pendingFile = e.target.files[0];
        });

        sendBtn.addEventListener('click', sendMessage);
        textInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });

        // auto-expand textarea
        textInput.addEventListener('input', () => {
            textInput.style.height = 'auto';
            textInput.style.height = textInput.scrollHeight + 'px';
        });

        function createMsgCol() {
            const col = document.createElement('div');
            col.className = 'msg-col';
            return col;
        }

        function sendMessage() {
            const text = textInput.value.trim();
            if (!text && !pendingFile) return;

            const userCol = createMsgCol();
            const userBubble = document.createElement('div');
            userBubble.className = 'bubble user';
            if (text) userBubble.appendChild(document.createElement('div')).innerText = text;

            if (pendingFile) {
                if (pendingFile.type.startsWith('image/')) {
                    const img = document.createElement('img');
                    img.src = URL.createObjectURL(pendingFile);
                    img.onload = () => URL.revokeObjectURL(img.src);
                    userBubble.appendChild(img);
                } else if (pendingFile.type.startsWith('audio/')) {
                    const audio = document.createElement('audio');
                    audio.controls = true;
                    audio.src = URL.createObjectURL(pendingFile);
                    userBubble.appendChild(audio);
                }
            }

            userCol.appendChild(userBubble);
            messages.appendChild(userCol);
            scrollToBottom();

            textInput.value = '';
            textInput.style.height = 'auto';
            fileInput.value = '';
            pendingFile = null;

            const aiCol = createMsgCol();
            const aiBubble = document.createElement('div');
            aiBubble.className = 'bubble ai';
            aiBubble.innerHTML = '<div class="meta">Assistant</div><div><span class="spinner"></span>Thinking...</div>';
            aiCol.appendChild(aiBubble);
            messages.appendChild(aiCol);
            scrollToBottom();

            setTimeout(() => {
                const reply = generateMockReply(text);
                updateAIBubble(aiBubble, reply);
            }, 900);
        }

        function updateAIBubble(bubbleEl, text) {
            bubbleEl.innerHTML = '';
            const meta = document.createElement('div'); meta.className = 'meta'; meta.innerText = 'Assistant';
            const content = document.createElement('div'); content.innerHTML = text.replace(/\n/g, '<br/>');
            bubbleEl.appendChild(meta); bubbleEl.appendChild(content);

            const copyBtn = document.createElement('button');
            copyBtn.className = 'copy-btn';
            copyBtn.title = 'Copy response';
            copyBtn.innerText = '📋';
            copyBtn.addEventListener('click', () => copyBubble(copyBtn));
            bubbleEl.appendChild(copyBtn);
            scrollToBottom();
        }

        function copyBubble(btnOrEl) {
            let bubble = btnOrEl.tagName?.toLowerCase() === 'button' ? btnOrEl.closest('.bubble') : btnOrEl;
            if (!bubble) return;
            const meta = bubble.querySelector('.meta');
            let text = '';
            Array.from(bubble.childNodes).forEach(node => {
                if (node === meta) return;
                if (node.nodeType === Node.TEXT_NODE) text += node.textContent;
                else text += node.innerText || '';
            });
            text = text.trim();
            navigator.clipboard.writeText(text).then(() => {
                const old = btnOrEl.innerText;
                btnOrEl.innerText = '✅';
                setTimeout(() => btnOrEl.innerText = '📋', 900);
            }).catch(() => alert('Copy failed — your browser may not allow clipboard access.'));
        }

        function scrollToBottom() { setTimeout(() => { messages.scrollTop = messages.scrollHeight; }, 30); }

        function generateMockReply(userText) {
            if (!userText) return 'Sure — feel free to attach an image or audio and then press Send.';
            return `You said: "${escapeHtml(userText)}"\n\nHere is a concise business-ready answer that you can copy.`;
        }
        function escapeHtml(s){ return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

        let recognition = null;
        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SR();
            recognition.lang = 'en-US';
            recognition.interimResults = false;
            recognition.onresult = (e) => { const text = e.results[0][0].transcript; textInput.value += (textInput.value ? ' ' : '') + text; };
            recognition.onend = () => voiceBtn.classList.remove('active');
        } else { recognition = null; }

        voiceBtn.addEventListener('click', () => {
            if (!recognition) { alert('Voice input not supported in this browser.'); return; }
            try { recognition.start(); voiceBtn.classList.add('active'); } catch (err) { console.warn(err); }
        });

        // initialize scroll
        scrollToBottom();
    </script>
