@{
    ViewBag.Title = "ChatGPT-like Chat";
}

<head>
    <!-- Bootstrap (optional, just for base utilities) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --sidebar-w: 72px;
            --max-width: 900px;
            --bg: #f6f7f8;
            --muted: #6b6f76;
            --accent: #10a37f;
        }

        .send-icon-btn {
            background-color: transparent;
            border: none;
            cursor: pointer;
        }

            .send-icon-btn:hover {
                color: #434242;
            }

        .icon-btn {
            background-color: transparent;
            border: none;
            border-radius: 50%; /* makes it rounded */
            transition: background-color 0.2s;
            cursor: pointer;
        }

            .icon-btn:hover {
                background-color: #f0f0f0; /* very light gray */
            }

        html, body {
            height: 100%;
            margin: 0;
            background: var(--bg);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            color: #111;
        }

        .app {
            min-height: 1vh;
            display: flex;
            align-items: stretch;
        }

        /* ===== Sidebar ===== */
        .sidebar {
            width: var(--sidebar-w);
            background: #111214;
            color: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 14px 8px;
            gap: 10px;
            box-shadow: 0 0 0 1px rgba(0,0,0,0.04) inset;
        }

            .sidebar .logo {
                width: 44px;
                height: 44px;
                border-radius: 8px;
                background: linear-gradient(180deg,#222 0,#111 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 2px 6px rgba(0,0,0,0.4);
            }

            .sidebar .icon-btn {
                width: 44px;
                height: 44px;
                border-radius: 10px;
                background: transparent;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                border: none;
                color: #dfe6ea;
            }

                .sidebar .icon-btn:hover {
                    background: rgba(255,255,255,0.03);
                    color: #fff;
                }

        /* ===== Center column ===== */
        .center {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 28px 16px;
        }

        .conversation-wrap {
            width: 100%;
            max-width: var(--max-width);
            display: flex;
            flex-direction: column;
            height: calc(100vh - 56px - 56px); /* header & input area reserve */
            background: transparent;
        }

        /* header region (top small bar) */
        .topbar {
            height: 26px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .topbar .title {
                font-weight: 600;
                font-size: 15px;
            }

            .topbar .subtitle {
                color: var(--muted);
                font-size: 13px;
            }

        /* chat card area */
        .chat-card {
            flex: 1;
            margin: 8px 0 12px 0;
            background: transparent;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .messages {
            padding: 28px 40px;
            overflow-y: auto;
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: center; /* we place each message inside a centered 'column' */
        }

        /* message column for centering narrower bubbles */
        .msg-col {
            width: 100%;
            max-width: 760px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .message.ai {
            align-self: flex-start;
        }

        .message.user {
            align-self: flex-end;
        }

        /* bubbles */
        .bubble {
            padding: 16px;
            border-radius: 12px;
            box-shadow: 0 6px 18px rgba(15,23,42,0.06);
            background: #fff;
            color: #111;
            position: relative;
            font-size: 15px;
            line-height: 1.45;
            border: 1px solid rgba(15,23,42,0.04);
            word-break: break-word;
        }

            .bubble.ai {
                background: #fff;
                color: #111;
            }

            .bubble.user {
                background: linear-gradient(90deg,#0b86ff,#0066d6);
                color: white;
            }

            .bubble .meta {
                font-size: 12px;
                color: var(--muted);
                margin-bottom: 8px;
            }

        /* copy button on AI bubble */
        .copy-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 14px;
            color: var(--muted);
            padding: 6px;
            border-radius: 6px;
        }

            .copy-btn:hover {
                background: rgba(0,0,0,0.04);
                color: #000;
            }

        /* media inside bubble */
        .bubble img {
            max-width: 320px;
            border-radius: 8px;
            display: block;
            margin-top: 8px;
        }

        .bubble audio {
            margin-top: 8px;
            width: 100%;
        }

        /* input area (bottom) - centered pill */
        .input-area {
            height: 72px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px 16px;
        }

        .input-pill {
            width: 100%;
            max-width: var(--max-width);
            display: flex;
            align-items: center;
            background: #fff;
            border-radius: 28px;
            padding: 8px 12px;
            box-shadow: 0 6px 20px rgba(15,23,42,0.06);
            gap: 10px;
            border: 1px solid rgba(15,23,42,0.06);
            position: relative;
        }

        .plus-btn {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            font-size: 20px;
            cursor: pointer;
            background: transparent;
            color: #333;
        }

        .plus-menu {
            position: absolute;
            left: 14px;
            bottom: 70px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            background: #fff;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 10px;
            padding: 6px;
            box-shadow: 0 8px 24px rgba(15,23,42,0.08);
            display: none; /* toggled by JS */
        }

            .plus-menu button {
                padding: 10px 14px;
                background: transparent;
                border: none;
                text-align: left;
                cursor: pointer;
                width: 160px;
            }

                .plus-menu button:hover {
                    background: #f6f7f8;
                }

        .text-input {
            flex: 1;
            border: none;
            outline: none;
            font-size: 16px;
            padding: 12px 14px;
            border-radius: 20px;
        }

        .right-tools {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: none;
            font-size: 16px;
            background: transparent;
        }

        .send-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(180deg,#0b86ff,#0066d6);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            border: none;
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(11,134,255,0.2);
        }

        /* small spinner for AI placeholder */
        .spinner {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid rgba(0,0,0,0.08);
            border-top-color: #888;
            animation: spin 1s linear infinite;
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }

        .plus-menu {
            left: 10px;
            bottom: 66px;
        }
    </style>
</head>
<body>
    <div class="app shadow">

        <!-- Center column -->
        <div class="center">
            <div class="conversation-wrap">

                <!-- Topbar -->
                <div class="topbar">
                    <div>
                        <div class="title">Smart Business Chat</div>
                        <div class="subtitle">AI Assistant • Secure • Fast</div>
                    </div>
                </div>

                <!-- Chat card -->
                <div class="chat-card">
                    <div class="messages" id="messages">
                        <!-- initial AI welcome (example) -->
                        <div class="msg-col">
                            <div class="bubble ai" data-role="ai">
                                <div class="meta">Assistant</div>
                                Hello! I’m ready to help. Click <strong>+</strong> to attach image/audio, or use the mic to speak.
                                <button class="copy-btn" title="Copy response" onclick="copyBubble(this)"><i class="fa fa-copy"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Input area -->
                <div class="input-area">
                    <div class="input-pill">
                        <button class="icon-btn" id="plusBtn" title="Add"><i class="fa fa-plus"></i></button>

                        <div class="plus-menu" id="plusMenu">
                            <button id="addImageBtn"><i class="fa fa-image"></i> Add Image</button>
                            <button id="addAudioBtn"><i class="fa fa-music"></i> Add Audio</button>
                        </div>

                        <input id="fileInput" type="file" accept="image/*,audio/*" style="display:none" />

                        <input id="textInput" class="text-input" placeholder="Ask anything..." autocomplete="off" />

                        <div class="right-tools">
                            <button class="send-icon-btn" id="voiceBtn" title="Voice input"><i class="fa fa-microphone"></i></button>
                            <button class="send-icon-btn" id="sendBtn" title="Send"><i class="fa fa-paper-plane"></i></button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- JS -->
    <script>
        // Elements
        const plusBtn = document.getElementById('plusBtn');
        const plusMenu = document.getElementById('plusMenu');
        const fileInput = document.getElementById('fileInput');
        const addImageBtn = document.getElementById('addImageBtn');
        const addAudioBtn = document.getElementById('addAudioBtn');
        const messages = document.getElementById('messages');
        const sendBtn = document.getElementById('sendBtn');
        const textInput = document.getElementById('textInput');
        const voiceBtn = document.getElementById('voiceBtn');

        let pendingFile = null;     // File user selected (image/audio)

        // Toggle plus menu
        plusBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          plusMenu.style.display = plusMenu.style.display === 'flex' ? 'none' : 'flex';
        });
        // close when clicking outside
        document.addEventListener('click', () => plusMenu.style.display = 'none');

        addImageBtn.addEventListener('click', () => {
          fileInput.accept = 'image/*';
          fileInput.click();
        });
        addAudioBtn.addEventListener('click', () => {
          fileInput.accept = 'audio/*';
          fileInput.click();
        });

        fileInput.addEventListener('change', (e) => {
          if (!e.target.files || !e.target.files[0]) return;
          pendingFile = e.target.files[0];
          // show quick preview badge in input area (small, inside pill) — optional UX
          // We'll show media inside the user's bubble when they send.
        });

        // send message on send button or Enter
        sendBtn.addEventListener('click', sendMessage);
        textInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
          }
        });

        function createMsgCol() {
          const col = document.createElement('div');
          col.className = 'msg-col';
          return col;
        }

        function sendMessage() {
          const text = textInput.value.trim();
          if (!text && !pendingFile) return;

          // Create user bubble
          const userCol = createMsgCol();
          const userBubble = document.createElement('div');
          userBubble.className = 'bubble user';
          if (text) {
            const p = document.createElement('div');
            p.innerText = text;
            userBubble.appendChild(p);
          }
          // attach media if present
          if (pendingFile) {
            if (pendingFile.type.startsWith('image/')) {
              const img = document.createElement('img');
              img.src = URL.createObjectURL(pendingFile);
              img.onload = () => URL.revokeObjectURL(img.src);
              userBubble.appendChild(img);
            } else if (pendingFile.type.startsWith('audio/')) {
              const audio = document.createElement('audio');
              audio.controls = true;
              audio.src = URL.createObjectURL(pendingFile);
              userBubble.appendChild(audio);
            }
          }
          userCol.appendChild(userBubble);
          messages.appendChild(userCol);
          scrollToBottom();

          // Reset input & pending
          textInput.value = '';
          fileInput.value = '';
          pendingFile = null;

          // Add AI placeholder bubble (thinking)
          const aiCol = createMsgCol();
          const aiBubble = document.createElement('div');
          aiBubble.className = 'bubble ai';
          aiBubble.innerHTML = '<div class="meta">Assistant</div><div><span class="spinner"></span>Thinking...</div>';
          aiCol.appendChild(aiBubble);
          messages.appendChild(aiCol);
          scrollToBottom();

          // ===== Replace below with real backend call =====
          // Example: send form data to your ASP.NET controller, receive text response.
          // const form = new FormData();
          // form.append('text', text);
          // if (file) form.append('file', file);
          // fetch('/api/chat', { method:'POST', body: form })
          //   .then(r => r.json())
          //   .then(data => updateAIBubble(aiBubble, data.answer))
          //   .catch(err => updateAIBubble(aiBubble, 'Error: ' + err.message));
          //
          // For demo we simulate the response after 900ms.

          setTimeout(() => {
            // Simulated response text (replace with real API result)
            const reply = generateMockReply(text);
            updateAIBubble(aiBubble, reply);
          }, 900);
        }

        function updateAIBubble(bubbleEl, text) {
          // clear spinner & set content
          bubbleEl.innerHTML = '';
          const meta = document.createElement('div'); meta.className = 'meta'; meta.innerText = 'Assistant';
          const content = document.createElement('div'); content.innerHTML = text.replace(/\n/g, '<br/>');
          bubbleEl.appendChild(meta);
          bubbleEl.appendChild(content);

          // copy btn
          const copyBtn = document.createElement('button');
          copyBtn.className = 'copy-btn';
          copyBtn.title = 'Copy response';
          copyBtn.innerText = '📋';
          copyBtn.addEventListener('click', () => copyBubble(copyBtn));
          bubbleEl.appendChild(copyBtn);

          scrollToBottom();
        }

        function copyBubble(btnOrEl) {
          // if called with button element, find parent bubble
          let bubble;
          if (btnOrEl.tagName && btnOrEl.tagName.toLowerCase() === 'button') {
            bubble = btnOrEl.closest('.bubble');
          } else {
            bubble = btnOrEl;
          }
          if (!bubble) return;
          // find content node (exclude meta)
          const meta = bubble.querySelector('.meta');
          let text = '';
          // Combine remaining children text
          Array.from(bubble.childNodes).forEach(node => {
            if (node === meta) return;
            if (node.nodeType === Node.TEXT_NODE) text += node.textContent;
            else text += node.innerText || '';
          });
          text = text.trim();
          // Copy to clipboard
          navigator.clipboard.writeText(text).then(() => {
            // feedback
            const old = btnOrEl.innerText;
            btnOrEl.innerText = '✅';
            setTimeout(() => btnOrEl.innerText = '📋', 900);
          }).catch(() => {
            alert('Copy failed — your browser may not allow clipboard access.');
          });
        }

        function scrollToBottom() {
          // small timeout to let layout update
          setTimeout(() => {
            messages.scrollTop = messages.scrollHeight;
          }, 30);
        }

        function generateMockReply(userText) {
          if (!userText) return 'Sure — feel free to attach an image or audio and then press Send.';
          // small faux AI reply to demonstrate copy & multi-line
          return `You said: "${escapeHtml(userText)}"\n\nHere is a concise business-ready answer that you can copy.`;
        }
        function escapeHtml(s){ return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

        // ===== Voice input (basic) =====
        let recognition = null;
        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
          const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
          recognition = new SR();
          recognition.lang = 'en-US';
          recognition.interimResults = false;
          recognition.onresult = (e) => {
            const text = e.results[0][0].transcript;
            textInput.value += (textInput.value ? ' ' : '') + text;
          };
          recognition.onend = () => voiceBtn.classList.remove('active');
        } else {
          recognition = null;
        }

        voiceBtn.addEventListener('click', () => {
          if (!recognition) { alert('Voice input not supported in this browser.'); return; }
          try {
            recognition.start();
            voiceBtn.classList.add('active');
          } catch (err) {
            console.warn(err);
          }
        });

        // clicking sidebar icon: example hook (you said you'll integrate your sidebar)
        document.getElementById('sidebarChatBtn').addEventListener('click', () => {
          // you can open this view or focus input etc. placeholder
          textInput.focus();
        });
        // init scroll
        scrollToBottom();
    </script>
</body>