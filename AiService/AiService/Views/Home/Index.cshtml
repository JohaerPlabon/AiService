@using AiService.Domains.Entities
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject IHttpContextAccessor HttpCtx
@model ApplicationUser

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-5">Welcome</h1>
    @if (@User == null || @User.Identity == null || @User.Identity!.Name == null)
    {
        <p class="lead">Local signup, Google sign-in, and Guest access.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary" href="/Auth/SignUp">Sign up</a>
            <a class="btn btn-outline-secondary" href="/Auth/SignIn">Sign in</a>
        </div>
    }
    else
    {
        <h1 class="display-4 fw-bold mb-3">Unleash Your Creativity with AI</h1>
        <p class="lead mb-4">Generate videos, images, logos, voice, and more — all with credits you control.</p>
        <a href="#credits-section" class="btn btn-lg btn-light text-primary fw-bold shadow-lg">Buy Credits Now</a>
    }

</div>