@{
    ViewData["Title"] = "About Us";
}
<h1>@ViewData["Title"]</h1>

<!-- About Us Section -->
<div id="about" class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <!-- Image -->
            <div class="col-lg-5 mb-4">
                <img src="~/Assets/Images/aboutus.png"
                     alt="About Us"
                     class="img-fluid"
                     style="object-fit: cover; width: 100%; height: 400px;">
            </div>
            <div class="col-lg-1"></div>
            <!-- Text Content -->
            <div class="col-lg-6">
                <h2 class="fw-bold mb-3">About Our Company</h2>
                <p class="text-muted mb-3">
                    At <strong>Your Company Name</strong>, we leverage the power of AI to deliver
                    innovative solutions that simplify your life. Our mission is to empower
                    individuals and businesses with intelligent tools that are easy to use and
                    highly effective.
                </p>
                <p class="text-muted mb-4">
                    With years of expertise and a passionate team, we strive to push the
                    boundaries of technology, ensuring our users enjoy seamless experiences
                    across all devices and platforms.
                </p>
                <a href="#contact" class="btn btn-primary rounded-pill">Get in Touch</a>
            </div>
        </div>

        <!-- Optional Stats Row -->
        <div class="row text-center mt-5">
            <div class="col-md-4 mb-3">
                <h3 class="fw-bold">500+</h3>
                <p class="text-muted">Projects Completed</p>
            </div>
            <div class="col-md-4 mb-3">
                <h3 class="fw-bold">300+</h3>
                <p class="text-muted">Happy Clients</p>
            </div>
            <div class="col-md-4 mb-3">
                <h3 class="fw-bold">10+</h3>
                <p class="text-muted">Years of Experience</p>
            </div>
        </div>
    </div>
</div>