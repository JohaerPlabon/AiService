@using AiService.Domains.Entities
@model IEnumerable<PackagePlans>

<Head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <title>@ViewData["Title"] - Packages</title>
    <style>
        .card {
            border: 1px solid transparent;
            border-radius:10px;
        }

        .card:hover {
            border: 1.7px solid red;
                border-radius: 10px;
        }
    </style>

</Head>

<div class="container py-4">
    
    <!-- Category Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="packages-tab" data-bs-toggle="tab" href="#packages" role="tab" aria-controls="packages" aria-selected="true">Packages</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="custom-tab" data-bs-toggle="tab" href="#custom" role="tab" aria-controls="custom" aria-selected="false">Buy Credits</a>
        </li>
    </ul>

    <!-- Tab Content Wrapper -->
    <div class="tab-content">

        <!-- Packages Tab -->
        <div class="tab-pane fade show active" id="packages" role="tabpanel" aria-labelledby="packages-tab">
            <div class="row g-4">
                @foreach (var offer in Model)
                {
                    <div class="col-md-4">
                        <div class="card shadow h-100">
                            <a href="/Auth/SignIn" class="stretched-link text-decoration-none text-dark">
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(offer.Tag))
                                    {
                                        <span class="badge bg-success position-absolute top-0 end-0 m-2">@offer.Tag</span>
                                    }
                                    @if (offer.ShowTimer)
                                    {
                                        <span class="badge bg-secondary mb-2">⏰ @offer.RemainingTime.ToString(@"hh\:mm\:ss")</span>
                                    }
                                    <h5 class="card-title fw-semibold">@offer.Data</h5>
                                    <p class="fs-4 fw-bold text-primary mb-1">৳@offer.Price</p>
                                    <small class="text-muted"><i class="bi bi-calendar-event"></i> @offer.ValidityDays days</small>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Custom Buy Credits Tab -->
        <div class="tab-pane fade" id="custom" role="tabpanel" aria-labelledby="custom-tab">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card shadow-lg p-4 border-0 rounded-3">
                        <h4 class="card-title mb-3 text-center">Buy Credits</h4>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <label for="amount" class="form-label fw-semibold mb-0">Amount (Tk)</label>
                            <input type="number" id="amount" class="form-control w-50" min="0" value="100">
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="text-muted">Credits</span>
                            <span id="credits" class="fw-bold fs-5 text-primary">100</span>
                        </div>
                        <button class="btn btn-primary w-100 btn-lg rounded-pill">Buy Now</button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script>
        const amountInput = document.getElementById('amount');
        const creditsDisplay = document.getElementById('credits');

        amountInput.addEventListener('input', () => {
            let amount = parseInt(amountInput.value) || 0;
            creditsDisplay.textContent = amount;
        });
    </script>

    <style>
        #amount {
            text-align: right;
            font-weight: 500;
            font-size: 1.1rem;
        }

        #credits {
            font-size: 1.25rem;
        }

        .btn-primary {
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(13,110,253,0.3);
        }

        .btn-primary:hover {
            box-shadow: 0 6px 14px rgba(13,110,253,0.4);
        }
    </style>
</div>
