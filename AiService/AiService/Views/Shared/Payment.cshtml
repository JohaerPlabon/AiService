<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Choose Payment Method</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body d-grid gap-3">

                <!-- Bkash -->
                <button class="btn btn-light border rounded-3 py-2 d-flex align-items-center justify-content-between"
                        data-bs-toggle="modal" data-bs-target="#bkashForm" data-bs-dismiss="modal">
                    <div class="d-flex align-items-center">
                        <img src="~/Assets/Images/bkash.png" alt="Bkash" style="width:28px; height:28px;" class="me-2">
                        <span class="fw-semibold">bKash</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </button>

                <!-- Rocket -->
                <button class="btn btn-light border rounded-3 py-2 d-flex align-items-center justify-content-between"
                        data-bs-toggle="modal" data-bs-target="#rocketForm" data-bs-dismiss="modal">
                    <div class="d-flex align-items-center">
                        <img src="~/Assets/Images/rocket.png" alt="Rocket" style="width:28px; height:28px;" class="me-2">
                        <span class="fw-semibold">Rocket</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </button>

                <!-- Nagad -->
                <button class="btn btn-light border rounded-3 py-2 d-flex align-items-center justify-content-between"
                        data-bs-toggle="modal" data-bs-target="#nagadForm" data-bs-dismiss="modal">
                    <div class="d-flex align-items-center">
                        <img src="~/Assets/Images/nagad.png" alt="Nagad" style="width:28px; height:28px;" class="me-2">
                        <span class="fw-semibold">Nagad</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </button>

                <!-- Visa -->
                <button class="btn btn-light border rounded-3 py-2 d-flex align-items-center justify-content-between"
                        data-bs-toggle="modal" data-bs-target="#visaForm" data-bs-dismiss="modal">
                    <div class="d-flex align-items-center">
                        <img src="~/Assets/Images/visa.png" alt="Visa" style="width:28px; height:28px;" class="me-2">
                        <span class="fw-semibold">Visa / MasterCard</span>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </button>
            </div>
        </div>
    </div>
</div>


<!-- ==================== PAYMENT FORMS ==================== -->
<!-- Bkash Form Modal -->
<div class="modal fade" id="bkashForm" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header">
                <h5 class="modal-title">bKash Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Payment" asp-action="BkashPayment" method="post">
                <div class="modal-body">
                    <input type="hidden" name="amount" value="500" />
                    <div class="mb-3">
                        <label class="form-label">bKash Number</label>
                        <input type="text" name="phoneNumber" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Transaction ID</label>
                        <input type="text" name="trxId" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>


