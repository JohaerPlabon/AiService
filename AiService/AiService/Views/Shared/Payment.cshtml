<!-- Visa Form Modal -->
<div class="modal fade" id="visaForm" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header">
                <h5 class="modal-title">Visa / MasterCard Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Payment" asp-action="VisaPayment" method="post">
                <div class="modal-body">
                    <input type="hidden" name="amount" value="500" />
                    <div class="mb-3">
                        <label class="form-label">Card Number</label>
                        <input type="text" name="cardNumber" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Expiry (MM/YY)</label>
                            <input type="text" name="expiry" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">CVV</label>
                            <input type="password" name="cvv" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Pay Now</button>
                </div>
            </form>
        </div>
    </div>
</div>