@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject IHttpContextAccessor HttpCtx

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AiService</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AiService.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <!-- Hamburger Button -->
            <button class="btn btn-outline-secondary m-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
                <i class="bi bi-list"></i>
            </button>

            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AiService</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-flex align-items-center justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @* @if (User?.Identity?.IsAuthenticated ?? false)
                        { *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Package" asp-action="Index">Plans</a>
                            </li>
                        @* } *@

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Aboutus">About us</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <li>
                                <button class="btn btn-sm mt-1 me-4" style="background-color:#ffa1161f; color:#ffa116">
                                    Credits 0
                                </button>
                            </li>

                            <li class="nav-item dropdown">
                                <button class="btn p-0 border-0" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="~/Assets/Images/profile.png"
                                         alt="Profile"
                                         class="rounded-circle border"
                                         style="width:35px; height:35px; object-fit:cover;">
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow rounded-3 border-0 mt-2"
                                    aria-labelledby="profileDropdown"
                                    style="min-width: 220px;">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold">@User.Identity!.Name</div>
                                        <small class="text-muted">
                                            @User.FindFirst(ClaimTypes.Email)?.Value
                                        </small>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                            <i class="bi bi-person me-2"></i> Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Settings" asp-action="Index">
                                            <i class="bi bi-gear me-2"></i> Settings
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="btn btn-link btn-sm" asp-area="" asp-controller="Auth" asp-action="SignIn">Login</a>
                            </li>
                            <li>
                                <a class="btn btn-primary btn-sm ms-2" asp-area="" asp-controller="Auth" asp-action="SignUp">Sign Up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Sidebar Offcanvas -->
    <div class="offcanvas offcanvas-start shadow-lg border-end" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel" style="width:280px; background-color:#f8f9fa;">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title fw-bold text-primary" id="sidebarMenuLabel">
                <i class="bi bi-cpu me-2"></i> AiService
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body d-flex flex-column p-0">

            <!-- Navigation -->
            <ul class="nav flex-column mt-2">
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center px-3 py-2 fw-semibold text-dark hover-link" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-2 text-primary"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center px-3 py-2 fw-semibold text-dark hover-link" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2 text-success"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center px-3 py-2 fw-semibold text-dark hover-link" asp-controller="Library" asp-action="Index">
                        <i class="bi bi-journal-text me-2 text-warning"></i> Library
                    </a>
                </li>
            </ul>

            <!-- Services Accordion -->
            <div class="accordion accordion-flush mt-3" id="servicesAccordion">
                <div class="accordion-item border-0">
                    <h2 class="accordion-header" id="headingServices">
                        <button class="accordion-button collapsed px-3 py-2 fw-semibold text-dark bg-transparent hover-link"
                                type="button" data-bs-toggle="collapse" data-bs-target="#collapseServices"
                                aria-expanded="false" aria-controls="collapseServices">
                            <i class="bi bi-robot me-2 text-danger"></i> AI Services
                        </button>
                    </h2>
                    <div id="collapseServices" class="accordion-collapse collapse" aria-labelledby="headingServices" data-bs-parent="#servicesAccordion">
                        <div class="accordion-body py-2 px-3">
                            <ul class="nav flex-column small">
                                <li><a href="#" class="nav-link px-2 py-1 text-dark hover-link"><i class="bi bi-chat-dots me-2 text-info"></i> Chat AI</a></li>
                                <li><a href="#" class="nav-link px-2 py-1 text-dark hover-link"><i class="bi bi-image me-2 text-success"></i> Image Generator</a></li>
                                <li><a href="#" class="nav-link px-2 py-1 text-dark hover-link"><i class="bi bi-code-slash me-2 text-primary"></i> Code Assistant</a></li>
                                <li><a href="#" class="nav-link px-2 py-1 text-dark hover-link"><i class="bi bi-text-paragraph me-2 text-warning"></i> Summarizer</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Histories -->
            <div class="mt-3 border-top">
                <h6 class="fw-bold text-secondary px-3 pt-3">Recent Histories</h6>
                <ul class="list-unstyled px-3 small">
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">📝 Opened Note #1</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">🔄 Synced Device</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">⚙️ Updated Profile</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">⚙️ Updated Profile</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">⚙️ Updated Profile</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">⚙️ Updated Profile</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">⚙️ Updated Profile</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">⚙️ Updated Profile</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">⚙️ Updated Profile</a></li>
                    <li><a href="#" class="d-block py-1 text-decoration-none text-dark hover-link">⚙️ Updated Profile</a></li>
                </ul>
            </div>

            <!-- Upgrade Plan (sticks bottom) -->
            <div class="mt-auto border-top p-3">
                <a href="#" class="btn btn-gradient w-100 fw-bold rounded-pill">
                    🚀 Upgrade Plan
                </a>
            </div>
        </div>
    </div>

    <style>
        /* Subtle hover effect */
        .hover-link:hover {
            background-color: #f1f3f5;
            border-radius: 6px;
            transition: 0.2s ease-in-out;
        }

        /* Gradient Upgrade Button */
        .btn-gradient {
            background: linear-gradient(90deg, #ff7e5f, #feb47b);
            color: #fff !important;
            border: none;
        }

            .btn-gradient:hover {
                opacity: 0.9;
            }
    </style>


    <main role="main" class="flex-fill container pb-3">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white text-center p-3 mt-auto">
        <div class="container">
            &copy; 2025 - AiService -
            <a class="text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Logout Confirmation Modal -->
    <partial name="~/Views/Auth/ConfirmLogoutCard.cshtml" />
</body>
</html>
